#!/usr/bin/env python3
"""Plots from the runs.csv files written by analyze.py.
Usage: python3 plot_results.py            (run in the project folder; writes plots/*.png)
Reads results/, results_ospf/, results_overlay/ when present."""
import csv, statistics as st, sys
from pathlib import Path
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

OUT = Path("plots")
OUT.mkdir(exist_ok=True)
FOLDERS = ["results", "results_ospf", "results_overlay"]
LABEL = {"ipv6": "IPv6\n(scripted)", "srv6": "SRv6\n(scripted)",
         "ospf": "IPv6\nOSPFv3", "overlay_loose": "SRv6 over OSPF\nloose",
         "overlay_pinned": "SRv6 over OSPF\npinned", "overlay_pinned_fast": "SRv6 over OSPF\npinned+detector"}
COLOR = {"ipv6": "#B5521B", "srv6": "#2A62D6", "ospf": "#6B3FA0", "overlay_loose": "#8D9AAD",
         "overlay_pinned": "#5C6B84", "overlay_pinned_fast": "#0E8F7C"}


def load():
    data = {}
    for f in FOLDERS:
        p = Path(f) / "runs.csv"
        if not p.exists():
            print("skip (missing):", p)
            continue
        for r in csv.DictReader(open(p)):
            if r.get("error"):
                continue
            d = data.setdefault(r["mode"], {"lost": [], "int": [], "det": [], "rep": []})
            d["lost"].append(float(r["lost"]))
            d["int"].append(float(r["interruption_ms"]))
            if r.get("detect_ms"):
                d["det"].append(float(r["detect_ms"]))
                d["rep"].append(float(r["repair_ms"]))
    return data


def spread(ax, modes, data, key, ylabel, log=False, title=""):
    vals = [data[m][key] for m in modes]
    bp = ax.boxplot(vals, widths=0.5, showfliers=False, patch_artist=True)
    for patch, m in zip(bp["boxes"], modes):
        patch.set_facecolor(COLOR.get(m, "#999")); patch.set_alpha(0.35)
    for med in bp["medians"]:
        med.set_color("black")
    for i, (m, v) in enumerate(zip(modes, vals), 1):
        ax.scatter([i + (k % 7 - 3) * 0.04 for k in range(len(v))], v, s=22, color=COLOR.get(m, "#999"),
                   edgecolor="black", linewidth=0.4, zorder=3)

    ax.set_xticks(range(1, len(modes) + 1))
    ax.set_xticklabels([LABEL.get(m, m) + f"\nmean {st.fmean(data[m][key]):.0f}" for m in modes], fontsize=9)
    ax.set_ylabel(ylabel)
    ax.set_title(title)
    if log:
        ax.set_yscale("log")
    ax.grid(axis="y", alpha=0.3)


data = load()
if not data:
    sys.exit("no runs.csv found; run analyze.py on the results folders first")
print("modes found:", ", ".join(data))

# 1. scripted IPv6 vs SRv6 (same detector, same failure)
sc = [m for m in ("ipv6", "srv6") if m in data]
if len(sc) == 2:
    fig, axs = plt.subplots(1, 2, figsize=(10, 4.5))
    spread(axs[0], sc, data, "lost", "lost packets", title="Lost packets per failure (20 runs)")
    spread(axs[1], sc, data, "int", "interruption (ms)", title="Interruption per failure")
    for ax in axs: ax.set_ylim(0, 190)
    fig.tight_layout(); fig.savefig(OUT / "1_scripted_ipv6_vs_srv6.png", dpi=160); plt.close(fig)
    print("wrote plots/1_scripted_ipv6_vs_srv6.png")

# 2. every mode, log scale
order = [m for m in ("ipv6", "srv6", "ospf", "overlay_loose", "overlay_pinned", "overlay_pinned_fast") if m in data]
extra = [m for m in data if m not in order]
order += extra
if len(order) >= 2:
    fig, ax = plt.subplots(figsize=(11, 5))
    spread(ax, order, data, "int", "interruption (ms, log scale)", log=True,
           title="Interruption per failure, all modes")
    fig.tight_layout(); fig.savefig(OUT / "2_all_modes_interruption.png", dpi=160); plt.close(fig)
    print("wrote plots/2_all_modes_interruption.png")

# 3. detection vs repair
dm = [m for m in order if data[m]["det"]]
if dm:
    fig, ax = plt.subplots(figsize=(8, 4.5))
    det = [st.fmean(data[m]["det"]) for m in dm]
    rep = [st.fmean(data[m]["rep"]) for m in dm]
    ax.bar(range(len(dm)), det, color="#3B4A63", label="detection delay")
    ax.bar(range(len(dm)), rep, bottom=det, color="#0E8F7C", label="repair command")
    for i, (d, r) in enumerate(zip(det, rep)):
        ax.text(i, d + r + 2, f"{d:.0f} + {r:.1f} ms", ha="center", fontsize=9)
    ax.set_xticks(range(len(dm))); ax.set_xticklabels([LABEL.get(m, m) for m in dm], fontsize=9)
    ax.set_ylabel("ms (mean)"); ax.set_title("Where the outage time goes"); ax.legend()
    ax.set_ylim(0, max(d + r for d, r in zip(det, rep)) * 1.15)
    fig.tight_layout(); fig.savefig(OUT / "3_detection_vs_repair.png", dpi=160); plt.close(fig)
    print("wrote plots/3_detection_vs_repair.png")
